{
  "name": "openmem-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent, inspectable memory and context layer for AI coding agents",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chethana101/openmem.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": ["packages/*"],

  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r --parallel exec rm -rf dist .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm -r build && pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
