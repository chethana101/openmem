{
  "name": "openmem-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent, inspectable memory and context layer for AI coding agents",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": ["packages/*"],

  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r --parallel exec rm -rf dist .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
