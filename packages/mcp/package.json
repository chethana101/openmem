{
  "name": "openmem-mcp",
  "version": "0.1.0",
  "description": "MCP server for openmem",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": ["ai", "agent", "mcp", "memory", "copilot"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chethana101/openmem.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/chethana101/openmem/issues"
  },
  "homepage": "https://github.com/chethana101/openmem#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "openmem-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openmem-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
